{ ... }:
{
  boot.kernelParams = [
    "nvidia.NVreg_TemporaryFilePath=/var/tmp"
    "usbcore.autosuspend=-1"
  ];

  boot.loader.systemd-boot.enable = false;
  boot.loader.grub.enable = false;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.timeout = 5;

  boot.loader.limine = {
    enable = true;
    maxGenerations = 10;

    # The menu palette is generated by Stylix (see ./theme.nix) through
    # boot.loader.limine.style, so nothing colour-related belongs here.
    extraEntries = ''
      /Windows Boot Manager
        protocol: efi
        path: guid(3cd881a8-e41a-48ed-8237-975e1dd56f52):/EFI/Microsoft/Boot/bootmgfw.efi
    '';
  };

  boot.plymouth.enable = false;
}
